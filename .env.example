# ----- Serveur -----
PORT=3000
NODE_ENV=development
# Limite de requêtes par minute (optionnel, défaut 130).
RATE_LIMIT_PER_MIN=130
# Taille de page maximale pour la pagination (optionnel, défaut 200).
MAX_PER_PAGE=200

# ----- MongoDB Atlas -----
# Chaîne de connexion du cluster Atlas (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
DB_NAME=ambiance

# ----- Authentification -----
# Clé d'administration des endpoints de gestion (DELETE /devices, POST/PUT /locations).
ADMIN_API_KEY=change-me-admin-key
JWT_SECRET=change-me-jwt-secret

# ----- Bridge Phyphox -----
# URL de l'API vers laquelle le bridge envoie les mesures.
#   - En local :   http://localhost:3000
#   - Vers Render : https://xxxxxxxxxx.onrender.com
API_URL=http://localhost:3000
# Clé x-api-key d'un device (affichée par `npm run seed`). Le seed la synchronise
# automatiquement ici pour le device correspondant à LOCATION_SLUG.
DEVICE_API_KEY=dev_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Lieu ciblé par la collecte (slug d'un lieu existant).
LOCATION_SLUG=cafeteria-roger-gaudry
# URL d'accès distant de Phyphox (menu ⋮ → Autoriser l'accès à distance). Port 8080 par défaut.
PHYPHOX_URL=http://<ip-du-telephone>
# Nom du buffer sonore lu (dB selon l'expérience Phyphox).
PHYPHOX_BUFFER=dB